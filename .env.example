# ==============================================================================
# ShareStudy - Environment Variables Template (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL & EF Core)
# ------------------------------------------------------------------------------
POSTGRES_DB=sharestudy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Connection string for ASP.NET Core EF Core (DefaultConnection)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sharestudy;Username=postgres;Password=your_postgres_password_here
DefaultConnection=Host=localhost;Port=5432;Database=sharestudy;Username=postgres;Password=your_postgres_password_here

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE CONFIGURATION (MinIO - Local Development)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false

# ASP.NET Core Configuration mapping
Minio__Endpoint=localhost:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__BucketName=documents
Minio__UseSSL=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=YourSuperSecretKeyForJwtAuthenticationTokensMustBeAtLeast32BytesLong!
JWT_ISSUER=ShareStudyApi
JWT_AUDIENCE=ShareStudyClient
JWT_EXPIRY_MINUTES=30

# ASP.NET Core Configuration mapping
Jwt__Secret=YourSuperSecretKeyForJwtAuthenticationTokensMustBeAtLeast32BytesLong!
Jwt__Issuer=ShareStudyApi
Jwt__Audience=ShareStudyClient
Jwt__ExpiryMinutes=30

# ------------------------------------------------------------------------------
# 4. FRONTEND & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 5. PRODUCTION ENVIRONMENT VARIABLES (Render / Neon / Cloudflare R2 / Vercel)
# ------------------------------------------------------------------------------
# [RENDER BACKEND ENVIRONMENT VARIABLES]
# ConnectionStrings__DefaultConnection=Host=<neon-hostname>;Port=5432;Database=sharestudy;Username=<neon-user>;Password=<neon-password>;SSL Mode=Require;Trust Server Certificate=true
# Jwt__Secret=<your-production-high-entropy-jwt-secret-key-at-least-32-chars>
# Jwt__Issuer=ShareStudyApi
# Jwt__Audience=ShareStudyClient
# Storage__Provider=R2
# CloudflareR2__AccountId=<your-cloudflare-account-id>
# CloudflareR2__AccessKeyId=<your-cloudflare-r2-access-key-id>
# CloudflareR2__SecretAccessKey=<your-cloudflare-r2-secret-access-key>
# CloudflareR2__BucketName=sharestudy-documents
# CloudflareR2__PublicDomain=https://pub-<hash>.r2.dev
# Cors__AllowedOrigins__0=https://sharestudy.vercel.app

# [VERCEL FRONTEND ENVIRONMENT VARIABLES]
# VITE_API_URL=https://sharestudy-api.onrender.com/api
